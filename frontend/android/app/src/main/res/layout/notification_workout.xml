<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    android:background="@android:color/transparent">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Press de Banca"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_set_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Serie 1/3"
            android:textColor="#FF6961"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Working Controls (Reps & Weight Steppers) -->
    <LinearLayout
        android:id="@+id/notif_working_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:visibility="visible">

        <!-- Reps Card -->
        <LinearLayout
            android:id="@+id/notif_card_reps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_notif_card"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REPETICIONES"
                android:textColor="#A0A0A5"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageButton
                    android:id="@+id/notif_btn_reps_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_notif_stepper"
                    android:src="@drawable/ic_notif_minus"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="Menos repeticiones" />

                <TextView
                    android:id="@+id/notif_tv_reps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/notif_btn_reps_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_notif_stepper"
                    android:src="@drawable/ic_notif_plus"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="Más repeticiones" />
            </LinearLayout>
        </LinearLayout>

        <!-- Weight Card -->
        <LinearLayout
            android:id="@+id/notif_card_weight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_notif_card"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:gravity="center">

            <TextView
                android:id="@+id/notif_lbl_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PESO (KG)"
                android:textColor="#A0A0A5"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageButton
                    android:id="@+id/notif_btn_weight_minus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_notif_stepper"
                    android:src="@drawable/ic_notif_minus"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="Menos peso" />

                <TextView
                    android:id="@+id/notif_tv_weight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="60"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/notif_btn_weight_plus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_notif_stepper"
                    android:src="@drawable/ic_notif_plus"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:contentDescription="Más peso" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Resting State Layout -->
    <LinearLayout
        android:id="@+id/notif_resting_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_notif_card"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/notif_tv_rest_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descansando entre series"
            android:textColor="#FF9F0A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_tv_rest_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Descanso hasta 10:15"
            android:textColor="#A0A0A5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Action Button -->
    <Button
        android:id="@+id/notif_btn_main_action"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/btn_notif_accent"
        android:text="✔ Completar Serie"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>
