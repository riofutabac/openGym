<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_small_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Press de Banca · Serie 1/3"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <Chronometer
                android:id="@+id/notif_small_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#30D158"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notif_small_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 kg · 10 reps"
                android:textColor="#8E8E93"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/notif_small_action"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/btn_notif_accent"
        android:src="@drawable/ic_notif_check"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:layout_marginStart="12dp"
        android:contentDescription="Acción rápida" />

</LinearLayout>
