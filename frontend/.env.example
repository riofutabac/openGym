# openGym Frontend Environment Variables

# Backend Selection
# In standard web and mobile APK builds, Appwrite is the unified backend.
VITE_APPWRITE=1

# Appwrite Connection Configuration
# El endpoint de Appwrite Cloud es REGIONAL: usa el de tu proyecto (p. ej. sfo, fra, nyc).
# El generico https://cloud.appwrite.io/v1 responde 401 "Project is not accessible in this region".
VITE_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=opengym

# Bucket de Storage con la media de ejercicios (JPG + GIF). Lectura publica.
VITE_APPWRITE_BUCKET_ID=exercises

# OAuth (opcional). Sin esta variable el boton de OAuth no se muestra.
# Ponla solo cuando el provider este configurado con su Client ID/Secret en
# la consola de Appwrite; si no, el boton falla al pulsarlo.
# VITE_APPWRITE_OAUTH_PROVIDER=google

# Media Base URLs (Optional - defaults to local /img/ and /gif/)
# VITE_IMG_BASE=https://cloud.appwrite.io/v1/storage/buckets/exercises/files/
# VITE_GIF_BASE=https://cloud.appwrite.io/v1/storage/buckets/exercises/files/

# Standalone Build Flags (handled automatically by npm scripts)
# VITE_MOBILE=1  # Configures Capacitor native shell build
# VITE_DEMO=1    # Configures static demo build for GitHub Pages
